---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchModal from '@/components/SearchModal.astro';
import { SITE } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  image,
  type,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead {title} {description} {image} {type} />
  </head>
  <body class="noise bg-void text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="relative">
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <script>
      import { initMotion } from '@/lib/motion';
      import { SITE } from '@/lib/site';
      initMotion();
      // iOS Safari ignores user-scalable=no; its proprietary gesture events
      // close the pinch-zoom gap so the fixed chrome and hero never distort.
      document.addEventListener('gesturestart', (e) => e.preventDefault());
      // One wink for the curious.
      console.log(
        `%c⬢ blokz.dev — ${SITE.tagline.toLowerCase()}`,
        'color:#5b8cff;font-family:monospace;font-size:12px',
      );
      console.log(
        `%c  built in the open · ${SITE.repo}`,
        'color:#5b6378;font-family:monospace;font-size:11px',
      );
    </script>
  </body>
</html>
