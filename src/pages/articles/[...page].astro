---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleArchive from '@/components/ArticleArchive.astro';
import { getArticles, getTopics } from '@/lib/content-helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticles();
  return paginate(articles, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const topics = await getTopics();
---

<BaseLayout
  title="Articles — Blokz"
  description="The full Blokz archive: deep technical articles on AI, blockchain, agents, zero-knowledge systems, and the engineering between them."
>
  <ArticleArchive {page} {topics} sortKey="newest" />
</BaseLayout>
