---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { dateArchiveLabel, getArtifacts, groupByDate } from '@/lib/content-helpers';

const artifacts = await getArtifacts();
const { years } = groupByDate(artifacts);
---

<BaseLayout
  title="Browse artifacts by date — Blokz"
  description="Browse the Blokz artifacts lab by date: drill down from year to month to day across every published artifact."
  noindex
>
  <header class="mx-auto max-w-6xl px-5 pt-10 pb-12 sm:px-6">
    <p class="font-mono text-xs tracking-[0.3em] text-cyan uppercase" data-reveal>Index</p>
    <h1 class="mt-3 font-display text-page-title font-bold tracking-tight text-white" data-split>
      Browse by date
    </h1>
    <p class="mt-4 max-w-xl text-muted" data-reveal="0.2">
      Every artifact, grouped by when it was published. Pick a month to drill in, then a day from
      there.
    </p>
  </header>

  <section class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        years.map((y) => (
          <div class="card-hover glass rounded-2xl p-5" data-reveal-item>
            <div class="flex items-center justify-between">
              <a
                href={`/artifacts/date/${y.year}/`}
                class="font-display text-lg font-bold text-white transition-colors hover:text-accent"
              >
                {y.year}
              </a>
              <span class="font-mono text-xs text-faint">
                {y.count} artifact{y.count === 1 ? '' : 's'}
              </span>
            </div>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {y.months.map((m) => (
                <a
                  href={`/artifacts/date/${y.year}/${m.month}/`}
                  class="glass rounded-lg px-3 py-1.5 font-mono text-xs text-muted transition-all hover:border-accent/40 hover:text-white hover:shadow-glow-sm"
                >
                  {dateArchiveLabel(y.year, m.month).replace(` ${y.year}`, '')}
                  <span class="text-faint"> {m.count}</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
