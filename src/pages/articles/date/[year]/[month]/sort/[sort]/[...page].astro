---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateArchive from '@/components/DateArchive.astro';
import {
  ARTICLE_SORTS,
  ARTICLE_SORT_VARIANTS,
  dateArchiveLabel,
  dateScopedSorts,
  filterByDate,
  getArticles,
  getTopics,
  groupByDate,
  sortArticles,
  type ArticleSortKey,
} from '@/lib/content-helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticles();
  return groupByDate(articles).years.flatMap((y) =>
    y.months.flatMap((m) => {
      const bucket = filterByDate(articles, y.year, m.month);
      if (bucket.length <= 1) return [];
      return ARTICLE_SORT_VARIANTS.flatMap((key) =>
        paginate(sortArticles(bucket, key), {
          params: { year: y.year, month: m.month, sort: key },
          props: { year: y.year, month: m.month, sortKey: key },
          pageSize: 12,
        }),
      );
    }),
  );
}) satisfies GetStaticPaths;

const { page, year, month, sortKey } = Astro.props as typeof Astro.props & {
  year: string;
  month: string;
  sortKey: ArticleSortKey;
};
const topics = await getTopics();
const label = dateArchiveLabel(year, month);
const sortOptions = dateScopedSorts('/articles', ARTICLE_SORTS, year, month);
---

<BaseLayout
  title={`Articles — ${label}`}
  description={`Blokz articles published in ${label}, sorted.`}
  noindex
>
  <DateArchive {page} base="/articles" kind="article" {topics} {year} {month} {sortKey} {sortOptions} />
</BaseLayout>
