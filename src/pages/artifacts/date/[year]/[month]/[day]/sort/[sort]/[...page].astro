---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateArchive from '@/components/DateArchive.astro';
import {
  ARTIFACT_SORTS,
  ARTIFACT_SORT_VARIANTS,
  dateArchiveLabel,
  dateScopedSorts,
  filterByDate,
  getArtifacts,
  groupByDate,
  sortArtifacts,
  type ArtifactSortKey,
} from '@/lib/content-helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const artifacts = await getArtifacts();
  return groupByDate(artifacts).years.flatMap((y) =>
    y.months.flatMap((m) =>
      m.days.flatMap((d) => {
        const bucket = filterByDate(artifacts, y.year, m.month, d.day);
        if (bucket.length <= 1) return [];
        return ARTIFACT_SORT_VARIANTS.flatMap((key) =>
          paginate(sortArtifacts(bucket, key), {
            params: { year: y.year, month: m.month, day: d.day, sort: key },
            props: { year: y.year, month: m.month, day: d.day, sortKey: key },
            pageSize: 12,
          }),
        );
      }),
    ),
  );
}) satisfies GetStaticPaths;

const { page, year, month, day, sortKey } = Astro.props as typeof Astro.props & {
  year: string;
  month: string;
  day: string;
  sortKey: ArtifactSortKey;
};
const label = dateArchiveLabel(year, month, day);
const sortOptions = dateScopedSorts('/artifacts', ARTIFACT_SORTS, year, month, day);
---

<BaseLayout
  title={`Artifacts — ${label}`}
  description={`Blokz artifacts published on ${label}, sorted.`}
  noindex
>
  <DateArchive {page} base="/artifacts" kind="artifact" {year} {month} {day} {sortKey} {sortOptions} />
</BaseLayout>
