---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ArtifactCard from '@/components/ArtifactCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TopicChip from '@/components/TopicChip.astro';
import { getArticles, getArtifacts, getTopics } from '@/lib/content-helpers';
import { SITE } from '@/lib/site';

const articles = await getArticles();
const artifacts = await getArtifacts();
const topics = await getTopics();

const latest = articles.slice(0, 6);
const featuredArtifacts = [...artifacts].sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
).slice(0, 3);

// Per-topic article counts for the explore rail.
const counts = new Map<string, number>();
for (const a of articles) for (const t of a.data.topics) counts.set(t, (counts.get(t) ?? 0) + 1);
const railTopics = [...topics].sort((a, b) => (counts.get(b.id) ?? 0) - (counts.get(a.id) ?? 0));
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <!-- select-none: long-press on the hero must never pop a selection/callout
       over the scene; prose below stays fully selectable.
       svh (not dvh): the collapsing URL bar must not resize the canvas
       mid-scroll. touch-pan-y: vertical swipes scroll, horizontal swipes
       reach the scene as flick-to-spin gestures. -->
  <section
    class="relative -mt-20 flex min-h-[92svh] touch-pan-y items-center overflow-hidden select-none"
  >
    <canvas data-hero-canvas class="absolute inset-0 size-full" aria-hidden="true"></canvas>
    <div class="grid-veil absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-gradient-to-b from-transparent to-void"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-5 pt-28 pb-20 sm:px-6" data-scroll-fade>
      <p class="font-mono text-xs tracking-[0.3em] text-cyan uppercase" data-reveal>
        {SITE.org}
      </p>
      <h1
        class="mt-5 max-w-3xl font-display text-hero font-bold tracking-tight text-white"
        data-split
      >
        <!-- Canonical copy: SITE.tagline (src/lib/site.ts) — keep in sync. -->
        Where the <span class="text-gradient-brain">brain</span> meets the <span class="text-gradient-chain">chain</span>.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg" data-reveal="0.35">
        Deep technical writing and interactive artifacts on AI × blockchain — from neural nets to
        consensus, agents to smart contracts, and the infrastructure binding them together.
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal="0.5">
        <a
          href="/articles"
          class="rounded-xl bg-gradient-to-r from-accent to-violet px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition-transform hover:scale-[1.03] active:scale-[0.98]"
          data-magnetic
        >
          Read the articles
        </a>
        <a
          href="/artifacts"
          class="glass rounded-xl px-6 py-3 text-sm font-semibold text-text transition-all hover:border-accent/40 hover:text-white active:scale-[0.98]"
          data-magnetic
        >
          Explore artifacts ⬢
        </a>
      </div>

      <div class="mt-16 flex flex-wrap gap-2" data-reveal="0.65">
        {topics.slice(0, 8).map((t) => <TopicChip id={t.id} label={t.data.label} hue={t.data.hue} />)}
      </div>
    </div>

  </section>

  <!-- ============ EXPLORE BAR ============ -->
  <!-- The hero's bottom boundary: chevron cap fused into the strip (nothing
       floats over the scene) + a swipeable, auto-drifting topic rail with
       live article counts. -->
  <div id="explore" class="explore-bar border-y border-line/60 bg-ink/40 scroll-mt-16">
    <a href="#latest" class="explore-cap" aria-label="Skip to latest articles">
      <span>explore</span>
      <svg
        class="explore-chev"
        width="11"
        height="11"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m5 9 7 7 7-7"></path>
      </svg>
    </a>
    <div class="explore-rail" data-explore-rail>
      {
        [false, true].map((dup) => (
          <div class="explore-track" aria-hidden={dup ? 'true' : undefined}>
            {railTopics.map((t) => (
              <a
                href={`/topics/${t.id}`}
                class="explore-chip"
                style={`--chip-hue: ${t.data.hue}`}
                tabindex={dup ? -1 : undefined}
              >
                <i aria-hidden="true" />
                {t.data.label}
                <b>{counts.get(t.id) ?? 0}</b>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============ LATEST ARTICLES ============ -->
  <section id="latest" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 sm:px-6">
    <SectionHeading eyebrow="Journal" title="Latest articles" href="/articles" />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {latest.map((article) => <ArticleCard {article} {topics} />)}
    </div>
  </section>

  <!-- ============ ARTIFACTS ============ -->
  <section class="relative py-20">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(60% 50% at 50% 50%, rgba(139,92,246,0.07), transparent 70%);"
      aria-hidden="true"
      data-parallax-glow
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 sm:px-6">
      <SectionHeading
        eyebrow="Interactive"
        title="Featured artifacts"
        href="/artifacts"
        hrefLabel="All artifacts"
      />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {featuredArtifacts.map((artifact) => <ArtifactCard {artifact} />)}
      </div>
    </div>
  </section>

  <!-- ============ FOLLOW CTA ============ -->
  <section class="mx-auto max-w-6xl px-5 pt-10 sm:px-6">
    <div class="gradient-border ring-glow relative overflow-hidden rounded-3xl p-8 text-center sm:p-14" data-reveal>
      <div class="grid-veil absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
          Built in the open by <span class="text-gradient">Blokz Development Co.</span>
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-muted sm:text-base">
          Every article and artifact in this blog lives in a public repo. Follow the work, fork the
          experiments, or get in touch.
        </p>
        <div class="mx-auto mt-8 grid max-w-md grid-cols-3 gap-4">
          {
            [
              { n: articles.length, label: 'Articles' },
              { n: artifacts.length, label: 'Artifacts' },
              { n: topics.length, label: 'Topics' },
            ].map(({ n, label }) => (
              <div>
                <p class="font-display text-3xl font-bold text-white tabular-nums sm:text-4xl">
                  <span data-counter={n}>{n}</span>
                </p>
                <p class="mt-1 font-mono text-[10px] tracking-[0.2em] text-faint uppercase">{label}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-7 flex flex-wrap justify-center gap-3 text-sm">
          <a href={SITE.repo} target="_blank" rel="noopener" class="glass rounded-xl px-5 py-2.5 transition-colors hover:border-accent/40 hover:text-white">GitHub ↗</a>
          <a href={SITE.x} target="_blank" rel="noopener" class="glass rounded-xl px-5 py-2.5 transition-colors hover:border-accent/40 hover:text-white">{SITE.xHandle} on X ↗</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener" class="glass rounded-xl px-5 py-2.5 transition-colors hover:border-accent/40 hover:text-white">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canvas && !reduced) {
      // If WebGL is unavailable or mounting throws, drop the canvas silently —
      // the gradient + grid-veil backdrop carries the hero on its own.
      const start = () =>
        import('@/islands/hero-scene')
          .then(({ default: mountScene }) => {
            try {
              mountScene(canvas);
            } catch {
              canvas.remove();
            }
          })
          .catch(() => canvas.remove());
      'requestIdleCallback' in window ? requestIdleCallback(start) : setTimeout(start, 200);
    }
  </script>

  <script>
    // Explore rail: auto-drift via native scroll (so touch swipe, wheel, and
    // drag all just work), wrapping seamlessly over the duplicated track.
    // User interaction pauses the drift for a few seconds; reduced motion
    // disables drift entirely (the rail stays scrollable).
    const rail = document.querySelector<HTMLElement>('[data-explore-rail]');
    if (rail && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const track = rail.querySelector<HTMLElement>('.explore-track');
      let pos = 0;
      let idleUntil = 0;
      let last = performance.now();
      const defer = () => {
        idleUntil = performance.now() + 5000;
      };
      rail.addEventListener('pointerdown', defer, { passive: true });
      rail.addEventListener('wheel', defer, { passive: true });
      rail.addEventListener('touchstart', defer, { passive: true });
      rail.addEventListener('pointerenter', defer, { passive: true });
      const tick = (now: number) => {
        requestAnimationFrame(tick);
        const dt = Math.min((now - last) / 1000, 0.05);
        last = now;
        if (document.hidden || now < idleUntil || !track) return;
        const period = track.offsetWidth;
        if (period === 0) return;
        // Resync after manual scrolling, then advance with float precision.
        if (Math.abs(rail.scrollLeft - pos) > 1) pos = rail.scrollLeft;
        pos += 22 * dt;
        if (pos >= period) pos -= period;
        rail.scrollLeft = pos;
      };
      requestAnimationFrame(tick);
    }
  </script>
</BaseLayout>
