---
import type { Page } from 'astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Pagination from '@/components/Pagination.astro';
import SortBar from '@/components/SortBar.astro';
import TopicChip from '@/components/TopicChip.astro';
import {
  ARTICLE_SORTS,
  type Article,
  type ArticleSortKey,
  type Topic,
} from '@/lib/content-helpers';

/** The shared /articles archive body, parameterised by sort order. */
interface Props {
  page: Page<Article>;
  topics: Topic[];
  sortKey: ArticleSortKey;
}

const { page, topics, sortKey } = Astro.props;
// Only the default newest-first order reads as "Newer / Older"; other orders
// (oldest, A–Z, Z–A) use neutral pagination labels.
const dateDefault = sortKey === 'newest';
---

<header class="mx-auto max-w-6xl px-5 pt-10 pb-10 sm:px-6">
  <p class="font-mono text-xs tracking-[0.3em] text-cyan uppercase" data-reveal>Journal</p>
  <h1 class="mt-3 font-display text-page-title font-bold tracking-tight text-white" data-split>
    Articles
  </h1>
  <p class="mt-4 max-w-xl text-muted" data-reveal="0.2">
    {page.total} article{page.total === 1 ? '' : 's'} on the craft of AI × blockchain engineering.
    <button type="button" data-search-open class="text-accent hover:underline">Search the archive</button>,
    <a href="/articles/date/" class="text-accent hover:underline">browse by date</a>, or filter by topic:
  </p>
  <div class="mt-5 flex flex-wrap gap-2" data-reveal="0.3">
    {topics.map((t) => <TopicChip id={t.id} label={t.data.label} hue={t.data.hue} />)}
  </div>
  <div class="mt-6" data-reveal="0.35">
    <SortBar options={ARTICLE_SORTS} current={sortKey} />
  </div>
</header>

<section class="mx-auto max-w-6xl px-5 sm:px-6">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {page.data.map((article) => <ArticleCard {article} {topics} />)}
  </div>
  <Pagination
    page={page}
    prevLabel={dateDefault ? undefined : '← Prev'}
    nextLabel={dateDefault ? undefined : 'Next →'}
  />
</section>
