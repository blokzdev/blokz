---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArtifactMount from '@/components/ArtifactMount.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import TopicChip from '@/components/TopicChip.astro';
import { formatDate, getArticles, getArtifacts, getTopics } from '@/lib/content-helpers';
import { SITE } from '@/lib/site';

export const getStaticPaths = (async () => {
  const artifacts = await getArtifacts();
  return artifacts.map((artifact) => ({
    params: { slug: artifact.data.slug },
    props: { artifact },
  }));
}) satisfies GetStaticPaths;

const { artifact } = Astro.props;
const { data } = artifact;
const topics = await getTopics();

const typeLabel: Record<typeof data.type, string> = {
  three: 'WebGL · Three.js',
  canvas: 'Canvas 2D',
  svg: 'SVG',
  dom: 'DOM',
};
const topicEntries = data.topics
  .map((t) => topics.find((x) => x.id === t))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

// Articles that embed or reference this artifact.
const articles = await getArticles();
const linked = articles.filter((a) => a.data.artifacts.includes(data.slug));
---

<BaseLayout
  title={`${data.title} — Blokz Artifacts`}
  description={data.description}
  image={`/og/artifacts/${data.slug}.png`}
>
  <article class="mx-auto max-w-5xl px-5 pt-8 sm:px-6">
    <header data-pagefind-body data-pagefind-meta={`title:${data.title}`}>
      <nav class="font-mono text-xs text-faint" aria-label="Breadcrumb" data-reveal>
        <a href="/artifacts" class="hover:text-muted">artifacts</a>
        <span aria-hidden="true"> / </span>
        <span class="text-muted">{data.slug}</span>
      </nav>
      <h1 class="mt-5 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl" data-split>
        {data.title}
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted" data-reveal="0.2">{data.description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-2" data-reveal="0.3">
        {
          data.archetype && (
            <span class="rounded-md border border-violet/30 bg-void/70 px-2 py-0.5 font-mono text-[10px] tracking-wide text-violet uppercase">
              {data.archetype === 'scene' ? '3d scene' : data.archetype}
            </span>
          )
        }
        <span
          class="rounded-md border border-line bg-void/70 px-2 py-0.5 font-mono text-[10px] tracking-wide text-cyan uppercase"
        >
          {typeLabel[data.type]}
        </span>
        {topicEntries.map((t) => <TopicChip id={t.id} label={t.data.label} hue={t.data.hue} />)}
        <span class="ml-1 font-mono text-xs text-faint">
          {formatDate(data.pubDate)}
        </span>
      </div>
    </header>

    <div class="mt-10" data-reveal>
      <ArtifactMount slug={data.slug} />
    </div>

    <p class="mt-8 text-xs text-faint">
      <a
        href={`${SITE.repo}/blob/main/src/islands/artifacts/${data.slug}.ts`}
        target="_blank"
        rel="noopener"
        class="underline hover:text-muted"
      >
        View artifact source on GitHub ↗
      </a>
    </p>
  </article>

  {
    linked.length > 0 && (
      <section class="mx-auto mt-24 max-w-6xl px-5 sm:px-6">
        <h2 class="mb-7 font-display text-2xl font-bold text-white" data-reveal>
          Appears in
        </h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {linked.map((a) => (
            <ArticleCard article={a} {topics} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
