---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArtifactCard from '@/components/ArtifactCard.astro';
import { getArtifacts } from '@/lib/content-helpers';

const artifacts = await getArtifacts();
---

<BaseLayout
  title="Artifacts — Blokz"
  description="Interactive artifacts from the Blokz lab: WebGL scenes, visualizations, and explorable explanations of AI and blockchain systems."
>
  <header class="mx-auto max-w-6xl px-5 pt-10 pb-12 sm:px-6">
    <p class="font-mono text-xs tracking-[0.3em] text-cyan uppercase" data-reveal>Lab</p>
    <h1 class="mt-3 font-display text-page-title font-bold tracking-tight text-white" data-split>
      Artifacts <span class="text-gradient">⬢</span>
    </h1>
    <p class="mt-4 max-w-xl text-muted" data-reveal="0.2">
      Explorable, interactive pieces — every concept we write about, made tangible. Built with
      Three.js, GSAP, and the web platform.
    </p>
  </header>

  <section class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {artifacts.map((artifact) => <ArtifactCard {artifact} />)}
    </div>
  </section>
</BaseLayout>
