---
import { artifactUrl, formatDate, type Artifact } from '@/lib/content-helpers';
import { constellation } from '@/lib/constellation';

interface Props {
  artifact: Artifact;
}

const { artifact } = Astro.props;
const { data } = artifact;

const typeLabel: Record<typeof data.type, string> = {
  three: 'WebGL · Three.js',
  canvas: 'Canvas 2D',
  svg: 'SVG',
  dom: 'DOM',
};

const { pts, lines } = constellation(data.slug);
---

<article class="card-hover glass group relative flex h-full flex-col overflow-hidden rounded-2xl" data-reveal-item>
  <div class="relative aspect-video overflow-hidden border-b border-line bg-void">
    <div
      class="absolute inset-0 opacity-70"
      style={`background: radial-gradient(120% 100% at 50% 100%, rgba(91,140,255,0.22), transparent 60%), radial-gradient(80% 80% at 80% 0%, rgba(139,92,246,0.18), transparent 60%);`}
      aria-hidden="true"
    >
    </div>
    <svg
      class="absolute inset-0 size-full transition-transform duration-700 ease-out group-hover:scale-105"
      viewBox="0 0 100 56"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {
        lines.map((l) => (
          <line
            x1={l.a.x}
            y1={l.a.y}
            x2={l.b.x}
            y2={l.b.y}
            stroke="rgba(124,140,255,0.18)"
            stroke-width="0.2"
          />
        ))
      }
      {pts.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill={p.c} opacity="0.85" />)}
    </svg>
    <span
      class="absolute top-3 left-3 rounded-md border border-line bg-void/70 px-2 py-0.5 font-mono text-[10px] tracking-wide text-cyan uppercase backdrop-blur"
    >
      {typeLabel[data.type]}
    </span>
    <span
      class="absolute right-4 bottom-3 font-display text-4xl font-bold text-white/8 transition-all duration-500 select-none group-hover:rotate-30 group-hover:text-white/20"
      aria-hidden="true"
    >
      ⬢
    </span>
  </div>

  <div class="flex grow flex-col p-5">
    <h3 class="font-display text-lg leading-snug font-bold text-white">
      <a href={artifactUrl(artifact)} class="after:absolute after:inset-0">
        <span class="transition-colors group-hover:text-gradient">{data.title}</span>
      </a>
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{data.description}</p>
    <p class="mt-auto pt-4 text-xs text-faint">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    </p>
  </div>
</article>
