---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateArchive from '@/components/DateArchive.astro';
import {
  ARTIFACT_SORTS,
  dateChip,
  dateScopedSorts,
  getArtifacts,
  groupByDate,
} from '@/lib/content-helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const artifacts = await getArtifacts();
  return paginate(artifacts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const artifacts = await getArtifacts();
const children = groupByDate(artifacts).years.map((y) =>
  dateChip('/artifacts', y.year, undefined, undefined, y.count),
);
const sortOptions = dateScopedSorts('/artifacts', ARTIFACT_SORTS);
---

<BaseLayout
  title="Artifacts — By date"
  description="Browse the Blokz artifacts lab by date — drill down from year to month to day."
  noindex
>
  <DateArchive {page} base="/artifacts" kind="artifact" {children} {sortOptions} />
</BaseLayout>
