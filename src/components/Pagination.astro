---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
  /** Prev/next labels. Defaults read well for the newest-first date archive;
      non-date orders pass neutral "← Prev" / "Next →". */
  prevLabel?: string;
  nextLabel?: string;
}

const { page, prevLabel = '← Newer', nextLabel = 'Older →' } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-14 flex items-center justify-center gap-3 text-sm" aria-label="Pagination">
      {page.url.prev ? (
        <a
          href={page.url.prev}
          class="glass rounded-lg px-4 py-2 text-muted transition-all hover:border-accent/40 hover:text-white hover:shadow-glow-sm"
        >
          {prevLabel}
        </a>
      ) : (
        <span class="rounded-lg border border-line px-4 py-2 text-faint/50">{prevLabel}</span>
      )}
      <span class="font-mono text-xs text-faint tabular-nums">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a
          href={page.url.next}
          class="glass rounded-lg px-4 py-2 text-muted transition-all hover:border-accent/40 hover:text-white hover:shadow-glow-sm"
        >
          {nextLabel}
        </a>
      ) : (
        <span class="rounded-lg border border-line px-4 py-2 text-faint/50">{nextLabel}</span>
      )}
    </nav>
  )
}
