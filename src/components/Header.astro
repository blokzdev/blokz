---
import { NAV, SITE } from '@/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="glass mx-auto mt-3 flex max-w-6xl items-center justify-between rounded-2xl px-4 py-2.5 sm:px-6 md:mt-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="bz" x1="0" y1="0" x2="32" y2="32">
            <stop stop-color="#5b8cff"></stop>
            <stop offset="0.55" stop-color="#8b5cf6"></stop>
            <stop offset="1" stop-color="#22d3ee"></stop>
          </linearGradient>
        </defs>
        <path
          d="M16 2 28 9v14L16 30 4 23V9L16 2Z"
          stroke="url(#bz)"
          stroke-width="2.4"
          stroke-linejoin="round"></path>
        <path d="M16 9.5 22 13v6.5L16 23l-6-3.5V13l6-3.5Z" fill="url(#bz)" opacity="0.85"></path>
      </svg>
      <span class="font-display text-lg font-bold tracking-tight text-white">
        BLOKZ<span class="text-gradient">.dev</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map(({ label, href }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3.5 py-1.5 text-sm transition-colors',
              isActive(href)
                ? 'bg-accent/12 text-white'
                : 'text-muted hover:bg-white/5 hover:text-white',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="flex items-center gap-2 rounded-lg border border-line bg-white/3 px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent/40 hover:text-white"
        aria-label="Search articles"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden rounded border border-line bg-ink px-1.5 font-mono text-[10px] text-faint lg:inline">⌘K</kbd>
      </button>

      <button
        type="button"
        data-menu-toggle
        class="rounded-lg border border-line p-2 text-muted hover:text-white md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    data-mobile-menu
    class="glass mx-auto mt-2 hidden max-w-6xl flex-col gap-1 rounded-2xl p-3 md:!hidden"
    aria-label="Mobile"
  >
    {
      NAV.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'rounded-lg px-4 py-2.5 text-sm',
            isActive(href) ? 'bg-accent/12 text-white' : 'text-muted',
          ]}
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>

<!-- Spacer so content clears the fixed header. -->
<div class="h-20" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
