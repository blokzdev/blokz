---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DateArchive from '@/components/DateArchive.astro';
import {
  ARTIFACT_SORTS,
  dateArchiveLabel,
  dateScopedSorts,
  filterByDate,
  getArtifacts,
  groupByDate,
} from '@/lib/content-helpers';

export const getStaticPaths = (async ({ paginate }) => {
  const artifacts = await getArtifacts();
  return groupByDate(artifacts).years.flatMap((y) =>
    y.months.flatMap((m) =>
      m.days.flatMap((d) =>
        paginate(filterByDate(artifacts, y.year, m.month, d.day), {
          params: { year: y.year, month: m.month, day: d.day },
          props: { year: y.year, month: m.month, day: d.day },
          pageSize: 12,
        }),
      ),
    ),
  );
}) satisfies GetStaticPaths;

const { page, year, month, day } = Astro.props as typeof Astro.props & {
  year: string;
  month: string;
  day: string;
};
const label = dateArchiveLabel(year, month, day);
const sortOptions = dateScopedSorts('/artifacts', ARTIFACT_SORTS, year, month, day);
---

<BaseLayout
  title={`Artifacts — ${label}`}
  description={`Blokz artifacts published on ${label}: ${page.total} artifact${page.total === 1 ? '' : 's'} from the lab.`}
  noindex
>
  <DateArchive {page} base="/artifacts" kind="artifact" {year} {month} {day} {sortOptions} />
</BaseLayout>
