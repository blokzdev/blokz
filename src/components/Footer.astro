---
import { NAV, SITE } from '@/lib/site';

const year = new Date().getFullYear();

const socials = [
  {
    label: 'GitHub',
    href: SITE.github,
    icon: 'M12 2C6.5 2 2 6.6 2 12.2c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5 4-1.4 6.8-5.2 6.8-9.7C22 6.6 17.5 2 12 2Z',
  },
  {
    label: 'X',
    href: SITE.x,
    icon: 'M17.7 3H21l-7.1 8.2L22.2 21h-6.6l-5.1-6.5L4.6 21H1.3l7.6-8.7L1.5 3h6.7l4.7 6 4.8-6Zm-1.2 16h1.8L6.2 4.9H4.3L16.5 19Z',
  },
  {
    label: 'LinkedIn',
    href: SITE.linkedin,
    icon: 'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14Zm-.5 15.5v-5.3a3.3 3.3 0 0 0-3.3-3.3c-.85 0-1.84.5-2.32 1.3v-1.1h-2.8v8.4h2.8v-4.9c0-.8.64-1.45 1.44-1.45a1.45 1.45 0 0 1 1.45 1.45v4.9h2.73ZM6.88 8.56a1.69 1.69 0 0 0 1.68-1.68c0-.93-.76-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .92.76 1.68 1.69 1.68Zm1.39 9.94v-8.4H5.5v8.4h2.77Z',
  },
] as const;
---

<footer class="relative mt-28 border-t border-line">
  <div class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent"></div>

  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl font-bold text-white">
        BLOKZ<span class="text-gradient">.dev</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted">
        <span class="lowercase">{SITE.tagline}</span> — engineering notes and interactive artifacts
        from the frontier of AI × blockchain, by
        <a href={SITE.linkedin} class="text-text underline decoration-line underline-offset-2 hover:text-white">{SITE.org}</a>.
      </p>
      <div class="mt-5 flex gap-3">
        {
          socials.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              aria-label={label}
              class="rounded-lg border border-line p-2 text-muted transition-colors hover:border-accent/50 hover:text-white"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={icon} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-label="Footer">
      <p class="font-display text-sm font-semibold tracking-wide text-white uppercase">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a href={href} class="text-muted transition-colors hover:text-white">
                {label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml" class="text-muted transition-colors hover:text-white">RSS</a></li>
      </ul>
    </nav>

    <div>
      <p class="font-display text-sm font-semibold tracking-wide text-white uppercase">Open source</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href={SITE.repo} target="_blank" rel="noopener" class="text-muted transition-colors hover:text-white">
            Source on GitHub
          </a>
        </li>
        <li><a href="/about#license" class="text-muted transition-colors hover:text-white">Licensing</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-5 py-5 text-xs text-faint sm:px-6">
      © {year} {SITE.org}. Code MIT-licensed · Content CC BY 4.0.
    </p>
  </div>
</footer>
