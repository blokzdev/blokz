---
import { getEntry } from 'astro:content';
import { constellation } from '@/lib/constellation';
import { formatDate } from '@/lib/content-helpers';

/**
 * Mounts an interactive artifact by slug. Lazy: the entry module in
 * src/islands/artifacts/<slug>.ts is dynamically imported only when the
 * stage scrolls into view. Usable in pages and directly inside MDX.
 */
interface Props {
  slug: string;
  /** Override the manifest aspect ratio, e.g. "21/9". */
  aspect?: string;
  class?: string;
}

const { slug, aspect, class: className } = Astro.props;
const artifact = await getEntry('artifacts', slug);
if (!artifact) {
  throw new Error(`<ArtifactMount slug="${slug}"> — no manifest at content/artifacts/${slug}/manifest.json`);
}
const ratio = aspect ?? artifact.data.aspect;
// Full-bleed renderers (canvas/three) fill a fixed box; multi-region dom/svg
// artifacts grow to fit their reflowed content on portrait phones.
const fit = artifact.data.type === 'three' || artifact.data.type === 'canvas' ? 'bleed' : 'panes';
// The artifact's own seeded constellation stands in while the module loads.
const { pts, lines } = constellation(slug);
---

<figure class:list={['not-prose my-8', className]}>
  <div
    data-artifact={slug}
    data-fit={fit}
    class="artifact-box ring-glow relative overflow-hidden rounded-2xl border border-line bg-void"
    style={`--art-aspect: ${ratio};`}
  >
    <div
      data-artifact-placeholder
      class="absolute inset-0 flex items-center justify-center transition-opacity duration-700"
      style="background: radial-gradient(100% 100% at 50% 100%, rgba(91,140,255,0.12), transparent 65%);"
    >
      <svg
        class="ph-pulse absolute inset-0 size-full"
        viewBox="0 0 100 56"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {
          lines.map((l) => (
            <line
              x1={l.a.x}
              y1={l.a.y}
              x2={l.b.x}
              y2={l.b.y}
              stroke="rgba(124,140,255,0.14)"
              stroke-width="0.2"
            />
          ))
        }
        {pts.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill={p.c} opacity="0.6" />)}
      </svg>
      <span class="relative font-mono text-xs tracking-widest text-faint uppercase">
        ⬢ loading artifact…
      </span>
    </div>
  </div>
  <figcaption class="mt-2.5 flex flex-wrap items-baseline justify-between gap-2 px-1 text-xs text-faint">
    <span>
      <span class="font-medium text-muted">{artifact.data.title}</span>
      {artifact.data.controls.length > 0 && <span> — {artifact.data.controls.join(' · ')}</span>}
      {
        artifact.data.dataAsOf && artifact.data.dataSource && (
          <span>
            {' · data as of '}
            <time datetime={artifact.data.dataAsOf.toISOString()}>
              {formatDate(artifact.data.dataAsOf)}
            </time>
            {' · '}
            <a
              href={artifact.data.dataSource.url}
              target="_blank"
              rel="noopener"
              class="underline decoration-line underline-offset-2 hover:text-muted"
            >
              {artifact.data.dataSource.label} ↗
            </a>
          </span>
        )
      }
    </span>
    <span class="flex items-center gap-3">
      <button
        type="button"
        data-artifact-fullscreen={slug}
        data-title={artifact.data.title}
        class="text-faint transition-colors hover:text-muted"
        aria-label={`Open ${artifact.data.title} fullscreen`}
      >
        ⛶ fullscreen
      </button>
      <a href={`/artifacts/${slug}`} class="text-accent hover:underline">open artifact ↗</a>
    </span>
  </figcaption>
</figure>

<style>
  /* Pre-mount the box holds the manifest aspect so the loading placeholder is
     sized. Once a multi-region (panes) artifact mounts, the box becomes
     content-driven so it grows to fit its reflowed portrait layout instead of
     cramming everything into a short fixed-aspect frame. Full-bleed (canvas/
     three) artifacts keep a fixed box, with a portrait-friendlier ratio on
     small screens. */
  .artifact-box {
    aspect-ratio: var(--art-aspect);
  }
  .artifact-box[data-fit='panes'].is-mounted {
    aspect-ratio: auto;
  }
  @media (max-width: 640px) {
    .artifact-box[data-fit='bleed'] {
      aspect-ratio: 4 / 5;
    }
  }

  /* Constellation breathes while the module loads; opt-in motion only. */
  @media (prefers-reduced-motion: no-preference) {
    .ph-pulse {
      animation: ph-pulse 2.6s ease-in-out infinite;
    }
  }
  @keyframes ph-pulse {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  import { openArtifactFullscreen } from '@/lib/artifact-fullscreen';

  type Mounter = { default: (el: HTMLElement) => () => void };
  const modules = import.meta.glob<Mounter>('../islands/artifacts/*.ts');
  const loadMount = async (slug: string): Promise<Mounter['default'] | undefined> => {
    const loader = modules[`../islands/artifacts/${slug}.ts`];
    if (!loader) {
      console.warn(`[artifact] no module for "${slug}" in src/islands/artifacts/`);
      return undefined;
    }
    return (await loader()).default;
  };

  const stages = document.querySelectorAll<HTMLElement>('[data-artifact]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        io.unobserve(el);
        const slug = el.dataset.artifact;
        if (!slug) continue;
        loadMount(slug).then((mountArtifact) => {
          if (!mountArtifact) return;
          mountArtifact(el);
          el.classList.add('is-mounted');
          el.querySelector('[data-artifact-placeholder]')?.classList.add('opacity-0', 'pointer-events-none');
        });
      }
    },
    { rootMargin: '160px' },
  );

  stages.forEach((el) => {
    if (reduced) {
      // Respect reduced motion: keep the static placeholder, offer opt-in.
      const ph = el.querySelector<HTMLElement>('[data-artifact-placeholder]');
      if (ph) {
        ph.querySelector('span')?.remove();
        ph.insertAdjacentHTML(
          'beforeend',
          '<button type="button" class="glass relative rounded-xl px-5 py-2.5 font-mono text-xs tracking-widest text-muted uppercase transition-all hover:border-accent/40 hover:text-white hover:shadow-glow-sm">▶ run animation</button>',
        );
        ph.querySelector('button')?.addEventListener('click', () => io.observe(el), { once: true });
      }
      return;
    }
    io.observe(el);
  });

  // Fullscreen: load the island on demand and re-mount it filling the viewport.
  document.querySelectorAll<HTMLButtonElement>('[data-artifact-fullscreen]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const slug = btn.dataset.artifactFullscreen;
      if (!slug) return;
      const title = btn.dataset.title ?? slug;
      btn.disabled = true;
      try {
        const mount = await loadMount(slug);
        if (mount) openArtifactFullscreen({ slug, title, mount });
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
