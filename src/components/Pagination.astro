---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="mt-14 flex items-center justify-center gap-3 text-sm" aria-label="Pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="glass rounded-lg px-4 py-2 text-muted transition-colors hover:text-white">
          ← Newer
        </a>
      ) : (
        <span class="rounded-lg border border-line px-4 py-2 text-faint/50">← Newer</span>
      )}
      <span class="font-mono text-xs text-faint">
        {page.currentPage} / {page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="glass rounded-lg px-4 py-2 text-muted transition-colors hover:text-white">
          Older →
        </a>
      ) : (
        <span class="rounded-lg border border-line px-4 py-2 text-faint/50">Older →</span>
      )}
    </nav>
  )
}
