---
import { NAV, SITE } from '@/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="fixed inset-x-0 top-0 z-50">
  <div
    data-header
    class="glass header-shell mx-auto mt-3 flex max-w-6xl items-center justify-between rounded-2xl px-4 py-2.5 sm:px-6 md:mt-4"
  >
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
      <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true" class="logo-mark">
        <defs>
          <linearGradient id="bz" x1="0" y1="0" x2="32" y2="32">
            <stop stop-color="#5b8cff"></stop>
            <stop offset="0.55" stop-color="#8b5cf6"></stop>
            <stop offset="1" stop-color="#22d3ee"></stop>
          </linearGradient>
        </defs>
        <path
          d="M16 2 28 9v14L16 30 4 23V9L16 2Z"
          stroke="url(#bz)"
          stroke-width="2.4"
          stroke-linejoin="round"></path>
        <path d="M16 9.5 22 13v6.5L16 23l-6-3.5V13l6-3.5Z" fill="url(#bz)" opacity="0.85"></path>
      </svg>
      <span class="font-display text-lg font-bold tracking-tight text-white">
        BLOKZ<span class="text-gradient">.dev</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map(({ label, href }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'nav-link relative rounded-lg px-3.5 py-1.5 text-sm transition-colors',
              isActive(href) ? 'text-white' : 'text-muted hover:text-white',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-search-open
        class="flex items-center gap-2 rounded-lg border border-line bg-white/3 px-3 py-1.5 text-sm text-muted transition-all hover:border-accent/40 hover:text-white hover:shadow-glow-sm"
        aria-label="Search articles"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden rounded border border-line bg-ink px-1.5 font-mono text-[10px] text-faint lg:inline">⌘K</kbd>
      </button>

      <button
        type="button"
        data-menu-toggle
        class="rounded-lg border border-line p-2 text-muted hover:text-white md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div data-mobile-menu class="menu-wrap mx-auto max-w-6xl px-3 md:hidden">
    <nav aria-label="Mobile">
      <div class="glass mt-2 flex flex-col gap-1 rounded-2xl p-3">
        {
          NAV.map(({ label, href }) => (
            <a
              href={href}
              class:list={[
                'rounded-lg px-4 py-2.5 text-sm',
                isActive(href) ? 'bg-accent/12 text-white' : 'text-muted',
              ]}
            >
              {label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<!-- Spacer so content clears the fixed header. -->
<div class="h-20" aria-hidden="true"></div>

<style>
  .header-shell {
    transition:
      margin-top 0.35s var(--ease-out-expo),
      border-color 0.35s var(--ease-out-expo),
      box-shadow 0.35s var(--ease-out-expo),
      background 0.35s var(--ease-out-expo);
  }
  .header-shell.is-scrolled {
    margin-top: 0.375rem;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    border-color: var(--color-line-bright);
    box-shadow: var(--shadow-glow-sm);
  }

  /* Gradient underline: grows on hover, pinned for the current page. */
  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0.875rem 0.3rem 0.875rem;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-cyan));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* Mobile menu: CSS grid-rows animation, degrades to instant. */
  .menu-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s var(--ease-out-expo);
  }
  .menu-wrap > nav {
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0.4s;
  }
  .menu-wrap.is-open {
    grid-template-rows: 1fr;
  }
  .menu-wrap.is-open > nav {
    visibility: visible;
  }

  .logo-mark {
    transition: transform 0.5s var(--ease-out-expo);
  }
  .group:hover .logo-mark {
    transform: rotate(90deg);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open') === true;
    toggle.setAttribute('aria-expanded', String(open));
  });

  const shell = document.querySelector<HTMLElement>('[data-header]');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      shell?.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    });
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
