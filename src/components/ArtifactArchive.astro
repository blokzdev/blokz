---
import type { Page } from 'astro';
import ArtifactCard from '@/components/ArtifactCard.astro';
import Pagination from '@/components/Pagination.astro';
import SortBar from '@/components/SortBar.astro';
import { ARTIFACT_SORTS, type Artifact, type ArtifactSortKey } from '@/lib/content-helpers';

/** The shared /artifacts gallery body, parameterised by sort order. */
interface Props {
  page: Page<Artifact>;
  sortKey: ArtifactSortKey;
}

const { page, sortKey } = Astro.props;
// Only the default newest-first order reads as "Newer / Older".
const dateDefault = sortKey === 'newest';
---

<header class="mx-auto max-w-6xl px-5 pt-10 pb-10 sm:px-6">
  <p class="font-mono text-xs tracking-[0.3em] text-cyan uppercase" data-reveal>Lab</p>
  <h1 class="mt-3 font-display text-page-title font-bold tracking-tight text-white" data-split>
    Artifacts <span class="text-gradient">⬢</span>
  </h1>
  <p class="mt-4 max-w-xl text-muted" data-reveal="0.2">
    {page.total} explorable, interactive piece{page.total === 1 ? '' : 's'} — every concept we write
    about, made tangible. <a href="/artifacts/date/" class="text-accent hover:underline">Browse by date</a>.
  </p>
  <div class="mt-6" data-reveal="0.35">
    <SortBar options={ARTIFACT_SORTS} current={sortKey} />
  </div>
</header>

<section class="mx-auto max-w-6xl px-5 sm:px-6">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
    {page.data.map((artifact) => <ArtifactCard {artifact} />)}
  </div>
  <Pagination
    page={page}
    prevLabel={dateDefault ? undefined : '← Prev'}
    nextLabel={dateDefault ? undefined : 'Next →'}
  />
</section>
